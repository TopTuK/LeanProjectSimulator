POSTGRES_USER=simultrain
POSTGRES_PASSWORD=simultrain
POSTGRES_DB=simultrain
WEB_PORT=8080

# Yandex ID OAuth app (https://oauth.yandex.ru)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080/auth/login-yandex
# VK ID app (https://id.vk.com/about/business): sign-in with VK, Odnoklassniki and Mail.ru.
# Only the app id is needed (PKCE flow); add the redirect URI to the app's trusted list.
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost:8080/auth/login-vk
# long random string that signs the login cookie
SESSION_SECRET=
# true when the site is served over https
COOKIE_SECURE=false

# Production only (docker-compose.production.yml, behind the shared nginx-proxy on pmi_network)
# VIRTUAL_HOST=pmsim.pmi.moscow
# WEB_HOST_PORT=8086
